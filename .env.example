# LangSmith tracing is opt-in. Never commit a real API key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=neutail-mission4

# Development-only: include rendered LLM messages and final response content in
# LangSmith's litellm.acompletion traces. This may contain customer data.
NEUTAIL_LLM_TRACE_BODIES=false

# Demo HS256 access-token validation. Use a long random value and never commit it.
NEUTAIL_JWT_SECRET=replace-with-a-long-random-demo-secret

# Shared password for the local demo login endpoint. The database has no
# password hashes; replace this with an external identity provider in production.
NEUTAIL_DEMO_PASSWORD=demo

# Trusted commerce-event authentication. This is server-to-server only; the
# browser uses the customer-authenticated /api/v1/demo/checkout route instead.
NEUTAIL_INTERNAL_EVENT_TOKEN=replace-with-a-long-random-internal-token

# Profiling demo policy: a New customer becomes Loyal on the third completed
# purchase in the rolling window. The Profiling classifier then derives the
# segment from affluence_band + loyalty_status.
NEUTAIL_PURCHASE_WINDOW_DAYS=90
NEUTAIL_LOYAL_PURCHASE_THRESHOLD=3
NEUTAIL_LOYALTY_POLICY_VERSION=purchase-90d-v1
NEUTAIL_DEMO_CHECKOUT_ENABLED=true

# Optional access-token lifetime; defaults to one hour and cannot exceed one day.
# NEUTAIL_ACCESS_TOKEN_TTL_SECONDS=3600

# Optional comma-separated UI origins. Defaults include localhost/127.0.0.1 on
# ports 3000, 4173, 5173, and 8080. Do not use "*" for deployed environments.
# NEUTAIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep demo startup self-contained; provider calls still use their normal APIs.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Development routes use NVIDIA NIM through LiteLLM.
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_API_KEY=replace-with-your-nvidia-api-key

# Clear intents use deterministic rules. Ambiguous intents use the gateway;
# customer-facing prose stays deterministic unless this flag is enabled.
NEUTAIL_RESPONSE_SYNTHESIS_LLM=false

# Discovery ranking remains deterministic. Enable only optional explanations;
# failures still return ranked products without explanation text.
NEUTAIL_DISCOVERY_EXPLANATIONS_LLM=false

# Size recommendations and risk remain deterministic. Enable only optional
# Fit-result wording; provider failures leave the structured result intact.
NEUTAIL_FIT_EXPLANATIONS_LLM=false

# Optional; defaults to the bundled SQLite database.
# NEUTAIL_DATABASE_URL=sqlite+pysqlite:////absolute/path/to/neutail_demo.db
